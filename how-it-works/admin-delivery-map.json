      "sendCopyToClient": {
        "type": "boolean",
        "default": true
      },
      "sendCopyToCompany": {
        "type": "boolean",
        "default": true
      },
      "emailSubject": {
        "type": "text",
        "default": "Your Jackson Group Builder Form"
      }
    }
  }
}